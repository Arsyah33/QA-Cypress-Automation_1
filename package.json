{
  "name": "cypress_example",
  "version": "1.0.0",
  "description": "cypress demo project",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress open",
    "cy:run:headless": "cypress run --headless",
    "cy:run:headed": "cypress run --headed",
    "cy:run:chrome": "cypress run --browser chrome",
    "cy:run:edge": "cypress run --browser edge",
    "cy:run:e2eTest": "npx cypress run --spec cypress/integration/examples/e2eTest.cy.js --headed --browser electron",
    "cy:run_dashboard": "npx cypress run --record --key 0ffa4faf-f3f0-4fd3-839d-0300c4c74141",
    "cy:run_e2e_dashboard": "npx cypress run --record --key 0ffa4faf-f3f0-4fd3-839d-0300c4c74141 --spec cypress/integration/examples/e2eTest.cy.js --headed --browser edge",
    "clean:report": "rimraf cypress/reports/mochawesome-report",
    "cy:run:clean": "npm run clean:report && npm run cy:run:e2eTest"
  },
  "keywords": [
    "cypress",
    "cucumber"
  ],
  "author": "arsyah",
  "license": "ISC",
  "dependencies": {
    "cypress-downloadfile": "^1.2.4"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^26.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "latest",
    "@cypress/browserify-preprocessor": "latest",
    "cypress": "^15.6.0",
    "cypress-mochawesome-reporter": "^5.0.0",
    "esbuild": "^0.28.2",
    "rimraf": "^6.1.3"
  },
  "type": "commonjs"
}
